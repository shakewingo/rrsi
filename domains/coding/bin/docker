#!/bin/sh
# Linux VPS: the docker socket needs root. Elsewhere (macOS with Docker Desktop
# or OrbStack) call the real docker on PATH, skipping this directory.
if [ "$(uname -s)" = Linux ]; then
  exec sudo -E -n /usr/bin/docker "$@"
fi
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd: -)
exec docker "$@"
